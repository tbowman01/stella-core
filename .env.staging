# ArcQubit Platform - Staging Environment
NODE_ENV=staging
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://arcqubit:staging_secure_password_123@localhost:5432/arcqubit_staging
POSTGRES_PASSWORD=staging_secure_password_123
DATABASE_POOL_SIZE=20
DATABASE_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_password_123
REDIS_DB=0
REDIS_TLS=false

# Authentication
JWT_SECRET=test_jwt_secret_for_staging_do_not_use_in_production_12345678
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Storage
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_APP_USER=arcqubit
MINIO_APP_PASSWORD=arcqubit_app_123
MINIO_BUCKET=arcqubit-documents

# Features
ENABLE_PLUGINS=true
ENABLE_AI_ASSISTANT=false
ENABLE_PQC=true
ENABLE_SSO=false

# Integration Tests
TEST_DATABASE_URL=postgresql://arcqubit:staging_secure_password_123@localhost:5432/arcqubit_test
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379
TEST_REDIS_PASSWORD=staging_redis_password_123
TEST_REDIS_DB=1
