# ArcQubit Platform - Staging Environment Configuration
# Copy this file to .env.staging and fill in the values

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=staging
PORT=3000
LOG_LEVEL=info

# =============================================================================
# DATABASE (PostgreSQL 16+)
# =============================================================================
DATABASE_URL=postgresql://arcqubit:CHANGE_ME@postgres:5432/arcqubit_staging
POSTGRES_PASSWORD=CHANGE_ME_secure_password_123
DATABASE_POOL_SIZE=20
DATABASE_SSL=false

# For direct connection from host:
# DATABASE_URL=postgresql://arcqubit:CHANGE_ME@localhost:5432/arcqubit_staging

# =============================================================================
# REDIS CACHE & QUEUE
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password_123
REDIS_DB=0
REDIS_TLS=false

# For direct connection from host:
# REDIS_HOST=localhost

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_256_bit_secret_key_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# =============================================================================
# STORAGE (MinIO/S3)
# =============================================================================
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minioadmin123
MINIO_APP_USER=arcqubit
MINIO_APP_PASSWORD=CHANGE_ME_arcqubit_app_123
MINIO_BUCKET=arcqubit-documents
MINIO_REGION=us-east-1

# For AWS S3 instead of MinIO:
# STORAGE_PROVIDER=s3
# S3_BUCKET=arcqubit-staging-documents
# S3_REGION=us-east-1
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_ENDPOINT=https://s3.amazonaws.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_PLUGINS=true
ENABLE_AI_ASSISTANT=false
ENABLE_PQC=true
ENABLE_SSO=false
ENABLE_MFA=true

# =============================================================================
# AI SERVICES (Optional)
# =============================================================================
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@arcqubit.com
FROM_NAME=ArcQubit Platform

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# DataDog APM
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX_REQUESTS=30
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=10

# =============================================================================
# CACHE TTL (seconds)
# =============================================================================
CACHE_TTL_USER=300
CACHE_TTL_TENANT=600
CACHE_TTL_DOCUMENT=180
CACHE_TTL_SEARCH=60
CACHE_TTL_SESSION=3600

# =============================================================================
# COMPLIANCE & AUDIT
# =============================================================================
AUDIT_LOG_RETENTION_DAYS=2555
ENABLE_AUDIT_LOGGING=true
ENABLE_PHI_REDACTION=true

# =============================================================================
# INTEGRATION TESTS
# =============================================================================
TEST_DATABASE_URL=postgresql://arcqubit:CHANGE_ME@localhost:5432/arcqubit_test
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379
TEST_REDIS_PASSWORD=CHANGE_ME_redis_password_123
TEST_REDIS_DB=1

# =============================================================================
# NGINX & SSL
# =============================================================================
DOMAIN=staging.arcqubit.local
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================
WORKER_CONCURRENCY_DOCUMENTS=5
WORKER_CONCURRENCY_EMBEDDINGS=3
WORKER_CONCURRENCY_PQC=2
WORKER_CONCURRENCY_COMPLIANCE=1
WORKER_CONCURRENCY_EMAIL=3

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=arcqubit-staging-backups
