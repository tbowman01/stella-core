# Database
DATABASE_URL="postgresql://user:password@localhost:5432/arcqubit?schema=public"
DATABASE_DIRECT_URL="postgresql://user:password@localhost:5432/arcqubit?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Blob Storage (Azure)
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER_NAME="documents"

# Or MinIO (local development)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="arcqubit-documents"

# Authentication
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# SSO (Okta example)
OKTA_DOMAIN=""
OKTA_CLIENT_ID=""
OKTA_CLIENT_SECRET=""
OKTA_ISSUER=""

# AI Services
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# PQC Libraries
PQC_ENABLED="true"
PQC_KEY_PATH="./keys/pqc"

# Application
NODE_ENV="development"
PORT="3000"
API_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Security
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="900000"

# Monitoring (optional)
SENTRY_DSN=""
LOG_LEVEL="info"

# Compliance
SOC2_ENABLED="true"
AUDIT_LOG_RETENTION_DAYS="2555" # 7 years
