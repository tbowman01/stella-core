# Database
DATABASE_URL="postgresql://user:password@localhost:5432/arcqubit?schema=public"
DATABASE_DIRECT_URL="postgresql://user:password@localhost:5432/arcqubit?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# Storage
STORAGE_TYPE="minio"  # minio, s3, or azure

# MinIO (local development)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="arcqubit"
MINIO_SECRET_KEY="arcqubit_minio"
MINIO_BUCKET="arcqubit-documents"
MINIO_USE_SSL="false"

# Azure Blob (production)
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER_NAME="documents"

# S3 (alternative)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET="arcqubit-documents"

# Authentication
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# SSO (Okta example)
OKTA_DOMAIN=""
OKTA_CLIENT_ID=""
OKTA_CLIENT_SECRET=""
OKTA_ISSUER=""

# AI Services
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# PQC Libraries
PQC_ENABLED="true"
PQC_KEY_PATH="./keys/pqc"

# Application
NODE_ENV="development"
PORT="3000"
API_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Security
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="900000"

# Monitoring (optional)
SENTRY_DSN=""
DATADOG_API_KEY=""
LOG_LEVEL="info"

# Email (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@arcqubit.com"

# Feature Flags
ENABLE_PLUGINS="true"
ENABLE_AI_ASSISTANT="true"
ENABLE_PQC="true"
ENABLE_SSO="false"

# Compliance
SOC2_ENABLED="true"
AUDIT_LOG_RETENTION_DAYS="2555" # 7 years
